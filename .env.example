# ZMK Vision runtime configuration
# Legacy initial-provider hint (telegram | max | none). After startup, enable/disable and configure bots in Admin → Боты.
MESSENGER_PROVIDER=none

# Keep provider tokens only in this protected server file. Never paste them into the web panel.
# Roles, recipients and alerts are configured in Admin → Боты after startup.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=
TELEGRAM_OPERATOR_IDS=
TELEGRAM_VIEWER_IDS=
# Public HTTPS URL required by Telegram Mini Apps; leave empty for local bot-only use
TELEGRAM_WEBAPP_URL=

# MAX messenger bot (alternative to Telegram)
MAX_BOT_TOKEN=
MAX_ADMIN_IDS=
MAX_OPERATOR_IDS=
MAX_VIEWER_IDS=

# Optional: on a fresh database this creates and enables the first camera.
# Leave empty when adding cameras through the web panel instead.
RTSP_CAM_01=

# Security hardening (set in production; leave empty only for isolated local demo)
ZMK_API_KEY=
# Секрет для внутреннего worker API (/api/internal/*). Если оставить пустым,
# API и inference/training worker сами согласуют его через файл
# /models/.worker-token на общем томе model-data — работает без ручной настройки.
# Задайте вручную, если хотите контролировать секрет.
ZMK_WORKER_TOKEN=
# Путь общего файла-секрета worker (по умолчанию /models/.worker-token)
ZMK_WORKER_TOKEN_FILE=/models/.worker-token
INFERENCE_DEVICE=0
INFERENCE_CONF=0.5
# ffmpeg (по умолчанию) отбрасывает повреждённые RTP/H.264 пакеты и лучше
# переносит проблемные NVR-потоки. opencv — только для диагностики.
CAMERA_DECODER=ffmpeg
# RTSP транспорт для инференса. auto (рекомендуется): пробует TCP, при
# неудаче переключается на UDP — часто лечит «в VLC работает, у нас нет».
# tcp — только TCP; udp — только UDP.
RTSP_TRANSPORT=auto
# Опциональный размер FFmpeg-буфера потока (пусто = значение по умолчанию).
# Для чёрного/замерзшего кадра попробуйте RTSP_BUFFER_SIZE (напр. 5).
RTSP_BUFFER_SIZE=
# Таймаут RTSP-сокета FFmpeg в мкс (защита от зависания ~30 сек в контейнере).
RTSP_STIMEOUT=5000000
# Ключ актуального FFmpeg для socket timeout. Для старой кастомной сборки
# OpenCV/FFmpeg можно переключить на stimeout.
RTSP_TIMEOUT_OPTION=timeout
# Жёсткие таймауты открытия и чтения камеры. После таймаута worker не блокирует
# остальные камеры и переключается на повторное подключение.
RTSP_OPEN_TIMEOUT_MS=8000
RTSP_READ_TIMEOUT_MS=8000
# После открытия RTSP worker ждёт keyframe H.264, не переоткрывая поток.
# Это важно для NVR, которые подключают клиента в середине GOP.
RTSP_KEYFRAME_GRACE_SECONDS=15
# Максимальная задержка RTP jitter buffer в микросекундах (100 мс = low latency).
RTSP_MAX_DELAY_US=100000
# Сколько неудачных кадров подряд считать камеру офлайн (чтобы не мигала).
OFFLINE_AFTER_FRAMES=3
# Через сколько секунд переподключать потерянный RTSP-поток.
RTSP_RECONNECT_SECONDS=5
# Частота служебного опроса/телеметрии/кадра/heartbeat камеры в секундах.
CAMERA_CONTROL_POLL_SECONDS=2
CAMERA_TELEMETRY_SECONDS=5
CAMERA_SNAPSHOT_SECONDS=3
# Частота реального MJPEG-превью в панели. Фактический FPS ограничен камерой/NVR и сетью.
CAMERA_LIVE_FPS=60
# Частота AI-аналитики отдельно от превью: не тормозит плавность live-видео.
CAMERA_INFERENCE_FPS=8
# При true старые лимиты 20 FPS автоматически поднимаются до 60 FPS после обновления.
# Установите false, если сеть или NVR намеренно должны работать на меньшей частоте.
CAMERA_HIGH_FPS_MODE=true
CAMERA_HEARTBEAT_SECONDS=5
RATE_LIMIT_PER_MINUTE=120
CORS_ORIGINS=http://localhost:5173
# Always-on training worker. It uses CPU fallback if NVIDIA runtime is absent.
TRAINING_WORKER_URL=http://training-worker:8010
# Shared volume path for uploaded YOLO datasets (backend + training worker)
DATASET_DIR=/datasets
# Shared volume path where downloaded ready-made models are stored
MODEL_DIR=/models
# Optional JSON array to override the ready-made model catalog passed to
# GET /api/models/presets (id/name/format/url/classes/category/description)
ZMK_MODEL_PRESETS_JSON=
# In-app updater. The updater sidecar mounts the host project dir + Docker
# socket so the "Обновить до последней версии" button really applies the
# new release and redeploys the stack. Token protects updater endpoints.
UPDATE_SERVICE_URL=http://updater:8020
ZMK_UPDATE_TOKEN=
ZMK_UPDATE_REPO=danilka-revin/zmk-videoanalytics
POSTGRES_PASSWORD=change-before-production
MINIO_ROOT_USER=zmkadmin
MINIO_ROOT_PASSWORD=change-before-production
