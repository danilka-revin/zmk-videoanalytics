# ZMK Vision runtime configuration
# none | telegram | max
MESSENGER_PROVIDER=none

TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=
TELEGRAM_OPERATOR_IDS=
TELEGRAM_VIEWER_IDS=
# Public HTTPS URL required by Telegram Mini Apps; leave empty for local bot-only use
TELEGRAM_WEBAPP_URL=

# MAX messenger bot (alternative to Telegram)
MAX_BOT_TOKEN=
MAX_ADMIN_IDS=
MAX_OPERATOR_IDS=
MAX_VIEWER_IDS=

RTSP_CAM_01=rtsp://user:password@camera/stream

# Security hardening (set in production; leave empty only for isolated local demo)
ZMK_API_KEY=
# Секрет для внутреннего worker API (/api/internal/*). Если оставить пустым,
# API и inference/training worker сами согласуют его через файл
# /models/.worker-token на общем томе model-data — работает без ручной настройки.
# Задайте вручную, если хотите контролировать секрет.
ZMK_WORKER_TOKEN=
# Путь общего файла-секрета worker (по умолчанию /models/.worker-token)
ZMK_WORKER_TOKEN_FILE=/models/.worker-token
INFERENCE_DEVICE=0
INFERENCE_CONF=0.5
# RTSP над TCP (надёжнее, чем UDP по умолчанию) — часто лечит "чёрный экран",
# когда камера работает в VLC, но не отображается на сайте.
RTSP_TRANSPORT=tcp
# Сколько неудачных кадров подряд считать камеру офлайн (чтобы не мигала).
OFFLINE_AFTER_FRAMES=3
# Через сколько секунд переподключать потерянный RTSP-поток.
RTSP_RECONNECT_SECONDS=5
RATE_LIMIT_PER_MINUTE=120
CORS_ORIGINS=http://localhost:5173
# Set when running: docker compose --profile training ...
TRAINING_WORKER_URL=
# Shared volume path for uploaded YOLO datasets (backend + training worker)
DATASET_DIR=/datasets
# Shared volume path where downloaded ready-made models are stored
MODEL_DIR=/models
# Optional JSON array to override the ready-made model catalog passed to
# GET /api/models/presets (id/name/format/url/classes/category/description)
ZMK_MODEL_PRESETS_JSON=
# In-app updater. The updater sidecar mounts the host project dir + Docker
# socket so the "Обновить до последней версии" button really applies the
# new release and redeploys the stack. Token protects updater endpoints.
UPDATE_SERVICE_URL=http://updater:8020
ZMK_UPDATE_TOKEN=
ZMK_UPDATE_REPO=danilka-revin/zmk-videoanalytics
POSTGRES_PASSWORD=change-before-production
MINIO_ROOT_USER=zmkadmin
MINIO_ROOT_PASSWORD=change-before-production
