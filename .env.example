# ZMK Vision runtime configuration
# none | telegram | max
MESSENGER_PROVIDER=none

TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=
TELEGRAM_OPERATOR_IDS=
TELEGRAM_VIEWER_IDS=
# Public HTTPS URL required by Telegram Mini Apps; leave empty for local bot-only use
TELEGRAM_WEBAPP_URL=

# MAX messenger bot (alternative to Telegram)
MAX_BOT_TOKEN=
MAX_ADMIN_IDS=
MAX_OPERATOR_IDS=
MAX_VIEWER_IDS=

RTSP_CAM_01=rtsp://user:password@camera/stream

# Security hardening (set in production; leave empty only for isolated local demo)
ZMK_API_KEY=
ZMK_WORKER_TOKEN=
INFERENCE_DEVICE=0
INFERENCE_CONF=0.5
RATE_LIMIT_PER_MINUTE=120
CORS_ORIGINS=http://localhost:5173
# Set when running: docker compose --profile training ...
TRAINING_WORKER_URL=
# In-app updater. The updater sidecar mounts the host project dir + Docker
# socket so the "Обновить до последней версии" button really applies the
# new release and redeploys the stack. Token protects updater endpoints.
UPDATE_SERVICE_URL=http://updater:8020
ZMK_UPDATE_TOKEN=
ZMK_UPDATE_REPO=danilka-revin/zmk-videoanalytics
POSTGRES_PASSWORD=change-before-production
MINIO_ROOT_USER=zmkadmin
MINIO_ROOT_PASSWORD=change-before-production
