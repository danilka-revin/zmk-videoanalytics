# Make `npm ci` during the Docker `web` image build resilient and fast.
#
# registry.npmjs.org is frequently slow or unreachable from some regions
# (notably RU/CN), which made the web build stage sit with no output for a long
# time and look "frozen forever". These settings make npm fail fast on a dead
# connection and transparently retry transient failures instead of hanging
# silently. To use a closer mirror instead of the default registry, set the
# NPM_REGISTRY build arg / ZMK_NPM_REGISTRY .env value (e.g.
# https://registry.npmmirror.com).
fetch-retries=5
fetch-retry-factor=2
fetch-retry-mintimeout=2000
fetch-retry-maxtimeout=20000
fetch-timeout=60000
# Reuse any already-downloaded package instead of round-tripping the registry.
prefer-offline=true
