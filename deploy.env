# =====================================================================
# Deploy overrides — VPS reg.ru, домен maisaak-3dprintlab.online
# =====================================================================
# start.sh принудительно переносит эти значения в .env при КАЖДОМ запуске,
# поэтому после обновления проекта достаточно просто запустить ./start.sh —
# пароли и домен применятся сами. Править нужно здесь, а не в .env.
# Удалите этот файл, чтобы отключить авто-применение.
# =====================================================================

# Вход в панель: admin (полный доступ) и director (только просмотр).
# Пароль 72327232 действует на оба аккаунта и на всех, кого создаст админ
# (дополнительно: bash set-passwords.sh — сбросить пароль у ВСЕХ разом).
ZMK_PASSWORD_AUTH=true
ZMK_INITIAL_PASSWORD=72327232
ZMK_DIRECTOR_PASSWORD=72327232

# Куки без флага Secure, чтобы вход работал и по http://IP:5173 (отладка),
# и по https://домен. Когда всё стабильно работает по домену — можно true.
ZMK_AUTH_COOKIE_SECURE=false

# Домен (apex). www.домен обслуживается автоматически тем же Caddy.
ZMK_DOMAIN=maisaak-3dprintlab.online

# Запускать HTTPS-прокси (Caddy) вместе со стеком: порты 80/443,
# бесплатные сертификаты Let's Encrypt, автопродление.
COMPOSE_PROFILES=https

# Адреса панели для CORS и Telegram Mini App.
CORS_ORIGINS=https://www.maisaak-3dprintlab.online,https://maisaak-3dprintlab.online
TELEGRAM_WEBAPP_URL=https://www.maisaak-3dprintlab.online/telegram
